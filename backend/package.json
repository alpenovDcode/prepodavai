    "@resvg/resvg-js": "^2.6.2",
    "https-proxy-agent": "^7.0.6",
    "mathjax-full": "^3.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "30.5.2",
    "mock-aws-s3": "^4.0.2",
    "nock": "^14.0.10",
    "prettier": "^3.1.1",
    "prisma": "^5.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "ws": "^8.21.0",
    "source-map-js": "^1.2.2",
    "tar-fs": "^3.1.1",
    "ip-address": "^10.7.4",
    "multer": "2.5.0",
    "qs": "6.16.1",
    "lodash": "4.18.1",
    "uuid": "$uuid",
    "image-size": "2.0.3",
    "file-type": "21.3.2",
    "@xmldom/xmldom": "0.9.12",
    "tmp": "^0.2.7",
    "underscore": "^1.13.8",
    "webpack": "^5.112.1",
    "ajv@>=7 <9": "^8.20.0",
    "minimatch@>=9 <10": "^9.0.9"
  }
