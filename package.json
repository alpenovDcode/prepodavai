{
  "name": "prepodavai",
  "version": "1.0.0",
  "description": "Преподавай - Модульная платформа для преподавателей",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "worker",
    "telegram-bot",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:frontend && npm run install:backend && npm run install:worker && npm run install:bot",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:worker": "cd worker && npm install",
    "install:bot": "cd telegram-bot && npm install",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:bot\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:worker": "cd worker && npm run start:dev",
    "dev:bot": "cd telegram-bot && npm run start:dev",
    "build": "npm run build:frontend && npm run build:backend && npm run build:worker && npm run build:bot",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:worker": "cd worker && npm run build",
    "build:bot": "cd telegram-bot && npm run build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "db:migrate": "cd backend && npm run prisma:migrate",
    "db:generate": "cd backend && npm run prisma:generate",
    "db:studio": "cd backend && npm run prisma:studio"
  },
  "overrides": {
    "cssstyle": "4.1.0",
    "ws": "^8.21.0",
    "source-map-js": "^1.2.2",
    "tar-fs": "^3.1.1",
    "ip-address": "^10.7.4",
    "multer": "2.5.0",
    "qs": "6.16.1",
    "lodash": "4.18.1",
    "image-size": "2.0.3",
    "file-type": "21.3.2",
    "@xmldom/xmldom": "0.9.12",
    "tmp": "^0.2.7",
    "underscore": "^1.13.8",
    "webpack": "^5.112.1",
    "ajv@>=7 <9": "^8.20.0",
    "minimatch@>=9 <10": "^9.0.9",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "7.1.7",
    "@next/eslint-plugin-next": {
      "fast-glob": "file:./security/fast-glob-compat.tgz"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  }
}
